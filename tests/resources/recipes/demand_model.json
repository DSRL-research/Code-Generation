{
  "capability": "demand_model",
  "description": "A model that forecasts the load of a microgrid, trained on its own readings, step by step: its inputs (earlier values, the hour and the weekday on a circle), a split (every 7th day of the month is for testing), training, and the test, whose scores go on the model's card.",
  "needs": ["load_readings"],
  "produces": "model",
  "output_fields": ["model", "mae"],
  "chain": {"source": "${load_readings}", "steps": [
    {"op": "reduce", "window": "1h", "aggregate": {"kw": "mean"}},
    {"op": "lag", "field": "kw", "lags": [1, 2, 24]},
    {"op": "map", "set": {
      "hour_sin": "sin(2 * pi * ts.hour / 24)", "hour_cos": "cos(2 * pi * ts.hour / 24)",
      "day_sin": "sin(2 * pi * ts.weekday() / 7)", "day_cos": "cos(2 * pi * ts.weekday() / 7)"}},
    {"op": "map", "set": {"set": "'test' if ts.day % 7 == 0 else 'train'"}},
    {"op": "train", "model": "${model_name}", "target": "kw",
     "features": ["kw_lag_1", "kw_lag_2", "kw_lag_24", "hour_sin", "hour_cos", "day_sin", "day_cos"],
     "where": "set == 'train'"},
    {"op": "predict", "model": "${model_name}", "as": "kw_pred"},
    {"op": "filter", "where": "set == 'test'"},
    {"op": "evaluate", "actual": "kw", "predicted": "kw_pred", "model": "${model_name}"}]}
}
