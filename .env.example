# Copy to .env to change a setting. Each one is SANDBOX_<NAME>; see src/config/settings.py.
SANDBOX_LOG_LEVEL=INFO
SANDBOX_POLICY_FILE=policy.json

# sources
SANDBOX_FETCH_TIMEOUT_SECONDS=10
SANDBOX_MAX_RESPONSE_BYTES=67108864
SANDBOX_MAX_RECORDS_PER_SOURCE=200000
# a list is written as JSON
SANDBOX_RECORD_TIME_FIELDS=["ts", "timestamp", "time", "date"]

# expressions
SANDBOX_MAX_EXPRESSION_LENGTH=500

# policy: switched off by default; true checks every chain against policy_file
SANDBOX_POLICY_ENABLED=false

# the trained models of the ML operators
SANDBOX_MODEL_DIR=models
